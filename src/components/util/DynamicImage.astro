---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface ImageData {
  source: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  image: ImageData;
  class?: string;
}

const { image, class: className, ...rest } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{svg,jpg,jpeg,png,webp}"
);

if (!images[image.source])
  throw new Error(
    `"${image.source}" does not exist in glob: "/src/assets/**/*.{svg,jpg,jpeg,png,webp}"`
  );
---

<Image
  src={images[image.source]()}
  alt={image.alt}
  width={image.width}
  height={image.height}
  class={className}
  {...rest}
/>
