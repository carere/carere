---
import ChevronDownIcon from "@/assets/icons/chevron-down.svg";
import Container from "@/components/layout/Container.astro";
import LinkButton from "@/components/ui/LinkButton.astro";
import MobileMenu from "@/components/ui/MobileMenu.astro";
import SiteLogo from "@/components/ui/SiteLogo.astro";
import { useTranslations, getLocalePath, type Locale } from "@/i18n/index";
import type { MenuData } from "@/types/index.d.ts";
import site from "@/config/site.json";

interface Props {
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

const typedMenuData = t.menu as MenuData;
const mainMenu = typedMenuData.main;
const contactMenu = typedMenuData.contact;

const headerHeight = site.settings.header_height;
const headerHeightMobile = site.settings.header_height_mobile;
const isHome =
  Astro.url.pathname === "/" ||
  Astro.url.pathname === "/fr/" ||
  Astro.url.pathname === "/fr";
---

<header
  class="header sticky top-0 grid place-items-center w-full z-(--z-index-sticky) bg-bg transition-transform duration-(--transition-timing-slower) ease-(--ease-out-quart)"
  style={`height: ${headerHeightMobile}; --header-height-desktop: ${headerHeight}`}
  id="header"
>
  <Container>
    <div class="flex items-center justify-between w-full">
      <SiteLogo />

      <nav class="hidden min-[1000px]:block">
        <ul class="flex items-center gap-xl">
          {
            mainMenu.map((item) => (
              <li class="nav-item relative">
                <a
                  href={getLocalePath(item.path, lang)}
                  class="nav-link relative flex items-center gap-xs py-sm text-text text-base font-medium no-underline transition-colors duration-(--transition-timing-fast) hover:text-link"
                >
                  {item.title}
                  {item.children && <ChevronDownIcon width={16} height={16} />}
                </a>
                {item.children && (
                  <div class="relative">
                    <ul class="dropdown-menu absolute top-full left-0 min-w-50 mt-sm p-sm bg-bg border border-border rounded-lg shadow-lg opacity-0 invisible -translate-y-sm transition-[opacity,visibility,transform] duration-(--transition-timing-slow) overflow-y-hidden">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={getLocalePath(child.path, lang)}
                            class="block px-md py-sm text-text rounded-md text-sm no-underline transition-[background-color] duration-(--transition-timing-slow) ease-linear hover:bg-bg-secondary hover:text-link"
                          >
                            {child.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            ))
          }
          <li>
            <LinkButton
              href={getLocalePath(contactMenu.path, lang)}
              ariaLabel={contactMenu.title}
              size="small"
            >
              {contactMenu.title}
            </LinkButton>
          </li>
        </ul>
      </nav>
      <MobileMenu lang={lang} />
    </div>
  </Container>
</header>

<!-- Minimal style block for nav-link underline pseudo-element animation and dropdown hover reveal,
     which require ::before and complex :has() selectors not achievable with Tailwind utilities -->
<style>
  .header.is-hidden {
    transform: translateY(-100%);
  }

  @media (min-width: 1000px) {
    .header {
      height: var(--header-height-desktop);
    }
  }

  .nav-link::before {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 100%;
    height: 2px;
    background-color: var(--color-link);
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform var(--transition-timing-slow);
  }

  .nav-link:hover::before {
    transform: translateX(-50%) scaleX(1);
  }

  .nav-item:has(.dropdown-menu):is(:hover, :focus-within) .dropdown-menu {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
</style>

<script>
  const header = document.getElementById("header");
  let lastScroll = 0;
  let ticking = false;

  const updateHeader = () => {
    const currentScroll = window.scrollY;

    if (currentScroll <= 0) {
      header?.classList.remove("is-hidden");
      lastScroll = currentScroll;
      ticking = false;
      return;
    }

    if (currentScroll > lastScroll && currentScroll > 100) {
      header?.classList.add("is-hidden");
    } else if (currentScroll < lastScroll) {
      header?.classList.remove("is-hidden");
    }

    lastScroll = currentScroll;
    ticking = false;
  };

  const onScroll = () => {
    if (!ticking) {
      requestAnimationFrame(updateHeader);
      ticking = true;
    }
  };

  window.addEventListener("scroll", onScroll, { passive: true });
</script>
