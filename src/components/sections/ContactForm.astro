---
import Container from "@/components/layout/Container.astro";
import Section from "@/components/layout/Section.astro";
import FormInput from "@/components/ui/FormInput.astro";
import FormLabel from "@/components/ui/FormLabel.astro";
import { useTranslations, getLocalePath, type Locale } from "@/i18n/index";

interface Props {
  lang?: Locale;
  defaultValues?: {
    inquiryType?: string;
    message?: string;
    name?: string;
    company?: string;
    email?: string;
    tel?: string;
    privacy?: boolean;
  };
  serverError?: string;
}

const { lang = "en", defaultValues, serverError } = Astro.props;
const t = useTranslations(lang);
---

<Section background="secondary">
  <Container size="small">
    <div class="mb-2xl">
      <p class="text-text text-base md:text-md leading-(--lh-relaxed)">
        {t.ui.contact.form_intro}
      </p>
    </div>

    <form
      class="flex flex-col gap-xl"
      method="POST"
      id="contact-form"
      data-lang={lang}
      data-submit-text={t.ui.contact.submit}
      data-submitting-text={t.ui.contact.submitting}
      data-error-text={t.ui.contact.submit_error}
    >
      <input type="hidden" name="lang" value={lang} />
      <fieldset>
        <FormLabel required>{t.ui.contact.inquiry_type}</FormLabel>
        <div class="flex flex-col gap-md mt-md">
          {
            t.ui.contact.inquiry_options.map((type) => (
              <label class="flex gap-md items-center cursor-pointer">
                <input
                  type="radio"
                  name="inquiryType"
                  value={type.value}
                  checked={defaultValues?.inquiryType === type.value}
                  class="w-5 h-5 shrink-0 border border-border cursor-pointer checked:border-primary checked:bg-primary"
                  required
                />
                <span class="text-text text-base leading-(--lh-normal)">
                  {type.label}
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="flex flex-col gap-md">
        <FormLabel for="message" required>
          {t.ui.contact.message_label}
        </FormLabel>
        <textarea
          id="message"
          name="message"
          class="w-full min-h-50 p-md border border-border rounded-xl bg-bg text-text text-base leading-(--lh-relaxed) resize-y transition-[border-color] duration-(--transition-timing-base) placeholder:text-text-light focus:border-primary"
          rows="8"
          required
          placeholder={t.ui.contact.message_placeholder}>{defaultValues?.message}</textarea>
      </div>

      <div class="flex flex-col gap-md">
        <FormLabel for="name" required>{t.ui.contact.name_label}</FormLabel>
        <FormInput
          type="text"
          id="name"
          name="name"
          required
          autocomplete="name"
          placeholder={t.ui.contact.name_placeholder}
          value={defaultValues?.name}
        />
      </div>

      <div class="flex flex-col gap-md">
        <FormLabel for="company" required>
          {t.ui.contact.company_label}
        </FormLabel>
        <FormInput
          type="text"
          id="company"
          name="company"
          required
          autocomplete="organization"
          placeholder={t.ui.contact.company_placeholder}
          value={defaultValues?.company}
        />
      </div>

      <div class="flex flex-col gap-md">
        <FormLabel for="email" required>{t.ui.contact.email_label}</FormLabel>
        <FormInput
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          placeholder={t.ui.contact.email_placeholder}
          value={defaultValues?.email}
        />
      </div>

      <div class="flex flex-col gap-md">
        <FormLabel for="tel">{t.ui.contact.phone_label}</FormLabel>
        <FormInput
          type="tel"
          id="tel"
          name="tel"
          autocomplete="tel"
          placeholder={t.ui.contact.phone_placeholder}
          value={defaultValues?.tel}
        />
      </div>

      <div class="flex flex-col gap-md">
        <label class="flex gap-md items-start cursor-pointer">
          <input
            type="checkbox"
            name="privacy"
            checked={defaultValues?.privacy}
            class="w-5 h-5 shrink-0 mt-0.5 border border-border cursor-pointer checked:border-primary checked:bg-primary"
            required
          />
          <span class="text-text text-base leading-(--lh-relaxed)">
            {t.ui.contact.privacy_consent.split("{link}")[0]}<a
              href={getLocalePath("/privacy", lang)}
              class="text-link underline underline-offset-4"
              target="_blank">{t.ui.contact.privacy_link_text}</a
            >{t.ui.contact.privacy_consent.split("{link}")[1]}
          </span>
        </label>
      </div>

      <div class="mt-lg">
        <button
          type="submit"
          disabled
          class="block w-full max-w-60 mx-auto p-md px-2xl border-2 border-primary rounded-full bg-[linear-gradient(to_right,var(--color-bg)_50%,var(--color-primary)_50%)] bg-size-[200%_100%] bg-right text-text-inverse text-base md:text-md tracking-[0.05em] text-center cursor-pointer transition-[background-position,color,border-color] duration-(--transition-timing-slow) hover:not-disabled:bg-left hover:not-disabled:text-text hover:not-disabled:border-primary disabled:opacity-50 disabled:cursor-not-allowed"
        >
          {t.ui.contact.submit}
        </button>
      </div>

      <p
        id="contact-error"
        class:list={["text-center text-sm text-status-error", !serverError && "hidden"]}
        role="alert"
      >
        {serverError}
      </p>
    </form>
  </Container>
</Section>

<script>
  import { actions } from "astro:actions";
  import { navigate } from "astro:transitions/client";

  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const submitBtn = form?.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    const errorEl = document.getElementById(
      "contact-error",
    ) as HTMLParagraphElement;

    if (!form || !submitBtn || !errorEl) return;

    function checkForm() {
      const inquirySelected = !!form.querySelector(
        'input[name="inquiryType"]:checked',
      );
      const message = (
        form.elements.namedItem("message") as HTMLTextAreaElement
      ).value.trim();
      const name = (
        form.elements.namedItem("name") as HTMLInputElement
      ).value.trim();
      const company = (
        form.elements.namedItem("company") as HTMLInputElement
      ).value.trim();
      const emailInput = form.elements.namedItem("email") as HTMLInputElement;
      const emailValid =
        emailInput.value.trim() !== "" && emailInput.validity.valid;
      const privacyChecked = (
        form.elements.namedItem("privacy") as HTMLInputElement
      ).checked;

      if (
        inquirySelected &&
        message &&
        name &&
        company &&
        emailValid &&
        privacyChecked
      ) {
        submitBtn.disabled = false;
      } else {
        submitBtn.disabled = true;
      }
    }

    form.addEventListener("input", checkForm);
    form.addEventListener("change", checkForm);
    checkForm();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const { lang, submitText, submittingText, errorText } = form.dataset;

      submitBtn.disabled = true;
      submitBtn.textContent = submittingText ?? "Submitting...";
      errorEl.classList.add("hidden");

      const formData = new FormData(form);
      formData.append("lang", lang ?? "en");

      const { error } = await actions.sendContactEmail(formData);

      if (!error) {
        navigate(lang === "fr" ? "/fr/contact/complete/" : "/contact/complete/");
      } else {
        errorEl.textContent =
          errorText ?? "Something went wrong. Please try again.";
        errorEl.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = submitText ?? "Submit";
      }
    });
  });
</script>
